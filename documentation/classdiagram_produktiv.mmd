%% Produktiv-Klassendiagramm (ohne sim/*, ohne core/gui_main.cpp)
%% Nur Klassen + Beziehungen (keine Structs/Enums/Typknoten)
classDiagram
  direction LR

  class Core_SystemController

  class UI_ControlPanel
  class UI_DisplayContent
  class UI_Display

  class Sens_NavigationSensors
  class Sens_CompassModule
  class Sens_GPSModule
  class Sens_WindModule
  class Sens_NMEA183BUS

  class Diag_Diagnostics

  class Steer_SourceHandler
  class Steer_SourcePolicyEngine
  class Steer_SourceTargetInterpreter
  class Steer_SourceExecutor
  class Steer_GPSModel
  class Steer_WindModel

  class Steer_SteeringOrchestrator
  class Steer_ImpulseFilter
  class Steer_CoreSteeringController
  class Steer_HeadingErrorCalculator
  class Steer_ObservationBuffer
  class Steer_Deadband
  class Steer_SteeringGuard

  class Act_PWMController

  %% ===== Top-Level (SystemController) =====
  Core_SystemController *-- UI_ControlPanel
  Core_SystemController *-- Sens_NavigationSensors
  Core_SystemController *-- Diag_Diagnostics
  Core_SystemController *-- Steer_SourceHandler
  Core_SystemController *-- Steer_SteeringOrchestrator
  Core_SystemController *-- UI_DisplayContent
  Core_SystemController *-- UI_Display

  %% ===== Sensorik =====
  Sens_NavigationSensors *-- Sens_CompassModule
  Sens_NavigationSensors *-- Sens_GPSModule
  Sens_NavigationSensors *-- Sens_WindModule
  Sens_NavigationSensors *-- Sens_NMEA183BUS

  %% ===== Source Handling =====
  Steer_SourceHandler --> Sens_NavigationSensors
  Steer_SourceHandler --> Diag_Diagnostics
  Steer_SourceHandler *-- Steer_SourcePolicyEngine
  Steer_SourceHandler *-- Steer_SourceTargetInterpreter
  Steer_SourceHandler *-- Steer_SourceExecutor

  Steer_SourcePolicyEngine --> Diag_Diagnostics
  Steer_SourceTargetInterpreter *-- Steer_GPSModel
  Steer_SourceTargetInterpreter *-- Steer_WindModel
  Steer_SourceExecutor --> Sens_NavigationSensors

  %% ===== Steering / CSC =====
  Steer_SteeringOrchestrator *-- Steer_ImpulseFilter
  Steer_SteeringOrchestrator *-- Steer_CoreSteeringController
  Steer_SteeringOrchestrator *-- Act_PWMController
  Steer_SteeringOrchestrator --> Sens_NavigationSensors

  Steer_CoreSteeringController *-- Steer_HeadingErrorCalculator
  Steer_CoreSteeringController *-- Steer_ObservationBuffer
  Steer_CoreSteeringController *-- Steer_SteeringGuard

  Steer_SteeringGuard *-- Steer_Deadband
