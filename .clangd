CompileFlags:
  Remove:
    - -mlongcalls
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fzero-init-padding-bits=*
    - -fno-malloc-dce
---
If:
  PathMatch: .*\.h
CompileFlags:
  Remove:
    - -x
    - -std=*
  Add:
    - -xc++-header
    - -std=gnu++17
    - -I/home/henri-32/projects/autopilot/include
    - -I/home/henri-32/projects/autopilot/platform/esp-idf/components/esp_driver_gpio/include
    - -I/home/henri-32/projects/autopilot/platform/esp-idf/components/esp_driver_i2c/include
    - -I/home/henri-32/projects/autopilot/platform/esp-idf/components/esp_hal_i2c/esp32/include
    - -I/home/henri-32/projects/autopilot/platform/esp-idf/components/esp_hal_i2c/include
