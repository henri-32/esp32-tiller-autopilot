CompileFlags:
  CompilationDatabase: .clangd-db/genericSTM32F411RE
  Add:
    - -Iinclude
    - -Isrc

---
If:
  PathMatch:
    - .*systemController\.cpp$
    - .*[\\/]include[\\/]core[\\/]systemController\.h$
    - .*[\\/]src[\\/]ui[\\/].*
    - .*[\\/]include[\\/]ui[\\/].*
CompileFlags:
  CompilationDatabase: .clangd-db/gui

---
If:
  PathMatch:
    - .*sim/.*
    - .*sim\\.*
CompileFlags:
  CompilationDatabase: .clangd-db/sim

---
If:
  PathMatch:
    - (^|.*/|.*\\\\)src[\\\\/]core[\\\\/]steering[\\\\/]csc[\\\\/].*
    - (^|.*/|.*\\\\)include[\\\\/]core[\\\\/]steering[\\\\/]csc[\\\\/].*
CompileFlags:
  CompilationDatabase: .clangd-db/native_csc

---
If:
  PathMatch:
    - .*test/test_csc/.*
    - .*test\\test_csc\\.*
CompileFlags:
  CompilationDatabase: .clangd-db/native_csc
  Add:
    - -DPIO_UNIT_TESTING
    - -DUNIT_TEST
    - -DUNITY_INCLUDE_CONFIG_H
    - -Itest
    - -Itest/test_csc
    - -I.pio/libdeps/native_csc/Unity/src
    - -I.pio/build/native_csc/unity_config
