CompileFlags:
  CompilationDatabase: .clangd-db/gui
  Add:
    - -Iinclude
    - -Isrc
    - -std=gnu++17

---
If:
  PathMatch:
    - .*sim/.*
    - .*sim\\.*
CompileFlags:
  CompilationDatabase: .clangd-db/sim

---
If:
  PathMatch:
    - (^|.*/|.*\\\\)src[\\\\/]core[\\\\/]steering[\\\\/]csc[\\\\/].*
    - (^|.*/|.*\\\\)include[\\\\/]core[\\\\/]steering[\\\\/]csc[\\\\/].*
CompileFlags:
  CompilationDatabase: .clangd-db/native_csc

---
If:
  PathMatch:
    - (^|.*/|.*\\\\)include[\\\\/]core[\\\\/]steering[\\\\/]csc[\\\\/].*\\.h
CompileFlags:
  Add:
    - -xc++

---
If:
  PathMatch:
    - .*test/test_csc/.*
    - .*test\\test_csc\\.*
CompileFlags:
  CompilationDatabase: .clangd-db/native_csc
  Add:
    - -DPIO_UNIT_TESTING
    - -DUNIT_TEST
    - -DUNITY_INCLUDE_CONFIG_H
    - -Itest
    - -Itest/test_csc
    - -I.pio/libdeps/native_csc/Unity/src
    - -I.pio/build/native_csc/unity_config
