{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Generate compile_commands.json",
      "type": "shell",
      "command": "pio",
      "args": [
        "run",
        "-t",
        "compiledb",
        "-e",
        "genericSTM32F411RE"
      ],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "export complete code to allsources.txt",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-ChildItem -Recurse -Path .\\src, .\\include -Include *.h,*.hpp,*.c,*.cpp | Sort-Object FullName | ForEach-Object { \"`n/* ===== FILE: $($_.FullName) ===== */`n\"; Get-Content -Raw $_.FullName } | Set-Content -NoNewline -Encoding UTF8 .\\all_sources.txt"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}