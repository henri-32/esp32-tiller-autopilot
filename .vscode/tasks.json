{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Refresh clangd databases (firmware + sim + native_csc)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".vscode/scripts/refresh-clangd-db.ps1"
      ],
      "linux": {
        "command": "bash",
        "args": [
          ".vscode/scripts/refresh-clangd-db.sh"
        ]
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Build sim",
      "type": "shell",
      "command": "pio",
      "windows": {
        "command": "C:\\Users\\henri\\.platformio\\penv\\Scripts\\pio.exe"
      },
      "args": [
        "run",
        "-e",
        "sim"
      ],
      "linux": {
        "command": "pio"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Simulation: run_simulation",
      "type": "shell",
      "dependsOn": [
        "PlatformIO: Build sim"
      ],
      "command": ".\\.pio\\build\\sim\\program.exe",
      "linux": {
        "command": "./.pio/build/sim/program"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Simulation: plot_drift",
      "type": "shell",
      "command": ".\\sim\\analysis\\venv\\Scripts\\python.exe",
      "args": [
        "sim\\plots\\plot_drift.py"
      ],
      "linux": {
        "command": "python3",
        "args": [
          "sim/plots/plot_drift.py"
        ]
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Simulation: run_simulation + plot_drift",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Simulation: run_simulation",
        "Simulation: plot_drift"
      ],
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Run native_csc tests",
      "type": "shell",
      "command": "pio",
      "windows": {
        "command": "C:\\Users\\henri\\.platformio\\penv\\Scripts\\pio.exe"
      },
      "args": [
        "test",
        "-e",
        "native_csc"
      ],
      "linux": {
        "command": "pio"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "export complete code to allsources.txt",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "Get-ChildItem -Recurse -Path .\\include, .\\src, .\\test -Include *.h,*.hpp,*.cpp | Sort-Object FullName | ForEach-Object { \"`n/* ===== FILE: $($_.FullName) ===== */`n\"; Get-Content -Raw $_.FullName } | Set-Content -NoNewline -Encoding UTF8 .\\all_sources.txt"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}

