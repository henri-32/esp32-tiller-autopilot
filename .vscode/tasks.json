{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PlatformIO: Refresh clangd databases (firmware + sim + native_csc)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".vscode/scripts/refresh-clangd-db.ps1"
      ],
      "linux": {
        "command": "bash",
        "args": [
          ".vscode/scripts/refresh-clangd-db.sh"
        ]
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Build sim",
      "type": "shell",
      "command": "pio",
      "windows": {
        "command": "C:\\Users\\henri\\.platformio\\penv\\Scripts\\pio.exe"
      },
      "args": [
        "run",
        "-e",
        "sim"
      ],
      "linux": {
        "command": "pio"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Simulation: run_simulation",
      "type": "shell",
      "dependsOn": [
        "PlatformIO: Build sim"
      ],
      "command": ".\\.pio\\build\\sim\\program.exe",
      "linux": {
        "command": "./.pio/build/sim/program"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Simulation: plot_drift",
      "type": "shell",
      "command": ".\\sim\\analysis\\venv\\Scripts\\python.exe",
      "args": [
        "sim\\plots\\plot_drift.py"
      ],
      "linux": {
        "command": "python3",
        "args": [
          "sim/plots/plot_drift.py"
        ]
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Simulation: run_simulation + plot_drift",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Simulation: run_simulation",
        "Simulation: plot_drift"
      ],
      "problemMatcher": []
    },
    {
      "label": "PlatformIO: Run native_csc tests",
      "type": "shell",
      "command": "pio",
      "windows": {
        "command": "C:\\Users\\henri\\.platformio\\penv\\Scripts\\pio.exe"
      },
      "args": [
        "test",
        "-e",
        "native_csc"
      ],
      "linux": {
        "command": "pio"
      },
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "export complete code to allsources.txt",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$out = '.\\all_sources.txt'; Set-Content -Path $out -Value '' -Encoding UTF8; Get-ChildItem -Recurse -Path .\\include, .\\src, .\\test, .\\sim -Include *.h,*.hpp,*.cpp | Sort-Object FullName | ForEach-Object { Add-Content -Path $out -Value \"`n/* ===== FILE: $($_.FullName) ===== */`n\" -Encoding UTF8; Add-Content -Path $out -Value (Get-Content -Raw $_.FullName) -Encoding UTF8 }"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "-lc",
          ": > all_sources.txt; find include src test sim -type f \\( -name '*.h' -o -name '*.hpp' -o -name '*.cpp' \\) | sort | while IFS= read -r f; do printf '\\n/* ===== FILE: %s ===== */\\n' \"$f\" >> all_sources.txt; cat \"$f\" >> all_sources.txt; done"
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}
