{
  "editor.defaultFormatter": "xaver.clang-format",
  "python.defaultInterpreterPath": "${workspaceFolder}/sim/analysis/venv",

  // --- Brackets & Quotes: stabil, aber nicht bevormundend ---
  "editor.autoClosingBrackets": "languageDefined",
  "editor.autoClosingQuotes": "languageDefined",
  "editor.autoSurround": "never",
  "editor.renderLineHighlight": "none",
  "vim.hlsearch": false,
  "vim.incsearch": false,

  // --- Dateizuordnungen ---
  "files.associations": {
    "*.ino": "cpp",
    "*.h": "cpp",
    "*.hpp": "cpp"
  },

  // --- C++ / clangd ---
  "[cpp]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd"
  },

  "clangd.arguments": [
    "--query-driver=*arm-none-eabi-g++*",
    "--query-driver=*arm-none-eabi-gcc*",
    "--query-driver=C:/*/.platformio/packages/toolchain-gccarmnoneeabi@*/bin/arm-none-eabi-*",
    "--query-driver=C:/*/.platformio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-*",
    "--query-driver=C:/Repositorys/Arduino_Projekte/Autopilot_git/.pio-core/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-*",
    "--query-driver=*/.pio-core/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-*",
    "--query-driver=C:/*/.platformio/packages/toolchain-gccmingw32/bin/*g++*",
    "--query-driver=*/.pio-core/packages/toolchain-gccmingw32/bin/*g++*",
    "--query-driver=C:/msys64/mingw64/bin/g++*",
    "--query-driver=/home/*/.platformio/packages/toolchain-gccarmnoneeabi@*/bin/arm-none-eabi-*",
    "--query-driver=/home/*/.platformio/packages/toolchain-gccarmnoneeabi/bin/arm-none-eabi-*",
    "--query-driver=/usr/bin/g++*",
    "--background-index",
    "--header-insertion=never",
    "--header-insertion-decorators=0"
  ],

  "editor.codeActionsOnSave": {
    "source.organizeImports": "never"
  },

  // --- Microsoft C/C++ Extension vollstaendig deaktiviert ---
  "C_Cpp.intelliSenseEngine": "Disabled",
  "C_Cpp.autocomplete": "Disabled",
  "C_Cpp.errorSquiggles": "Disabled",
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  }
}
